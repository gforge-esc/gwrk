# Copy to /etc/gwrk/runner.env. Supply secrets as separate files.
GWRK_RELEASE_ROOT=/opt/gwrk
GWRK_HOME=/var/lib/gwrk
GWRK_RUNTIME_DIR=/run/gwrk
GWRK_SECRETS_DIR=/etc/gwrk/secrets
GWRK_LISTEN_HOST=127.0.0.1
GWRK_LISTEN_PORT=18790
GWRK_PILOT_REPO=/var/lib/gwrk/repos/pilot
GWRK_PILOT_REPO_URL=https://github.com/OWNER/REPO.git
GWRK_APPROVED_AGENT=approved-plugin-id
GWRK_AGENT_PROBE=/usr/local/libexec/gwrk-agent-probe
GWRK_SLACK_ENABLED=0
